---
// Contact Form Component - Dark RFQ & Specification Request interface
import Container from '@/components/Container.astro';
---

<section id="contact" class="py-16 md:py-24 bg-dark-background border-b border-dark-border text-dark-foreground" data-ps="src/components/home/ContactForm.astro:hrgil0">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12" data-ps="src/components/home/ContactForm.astro:fufmab">
      <!-- Left Column: Support & Project Consultation Info -->
      <div class="lg:col-span-5 flex flex-col justify-between" data-ps="src/components/home/ContactForm.astro:fufmaa">
        <div data-ps="src/components/home/ContactForm.astro:fufma9">
          <h2 class="text-h2 font-bold tracking-tight text-dark-foreground mb-4" data-ps="src/components/home/ContactForm.astro:f1qe6b">
            Request Kit Specifications & Quotes
          </h2>
          <p class="text-base text-dark-muted-foreground leading-relaxed mb-8" data-ps="src/components/home/ContactForm.astro:p5uxva">
            Connect with our engineering and sales department to order pre-packaged kits, request CAD submittals, or discuss custom seismic bracket manufacturing.
          </p>

          <div class="space-y-6" data-ps="src/components/home/ContactForm.astro:fufma8">
            <div class="flex items-start gap-4" data-ps="src/components/home/ContactForm.astro:fufm9m">
              <div class="w-10 h-10 bg-primary/20 border border-primary/30 flex items-center justify-center text-primary shrink-0 rounded-sm" data-ps="src/components/home/ContactForm.astro:fufm9l">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div data-ps="src/components/home/ContactForm.astro:fufm9k">
                <h3 class="text-sm font-bold text-dark-foreground mb-1" data-ps="src/components/home/ContactForm.astro:dbgyo">Direct Engineering Support</h3>
                <p class="text-xs text-dark-muted-foreground" data-ps="src/components/home/ContactForm.astro:p5uxv9">specifications@seismicco.com</p>
                <p class="text-xs text-dark-muted-foreground" data-ps="src/components/home/ContactForm.astro:p5uxv8">quotes@seismicco.com</p>
              </div>
            </div>

            <div class="flex items-start gap-4" data-ps="src/components/home/ContactForm.astro:fufm9j">
              <div class="w-10 h-10 bg-secondary border border-dark-border flex items-center justify-center text-dark-foreground shrink-0 rounded-sm" data-ps="src/components/home/ContactForm.astro:fufm9i">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div data-ps="src/components/home/ContactForm.astro:fufm9h">
                <h3 class="text-sm font-bold text-dark-foreground mb-1" data-ps="src/components/home/ContactForm.astro:dbgyp">Manufacturing & Distribution</h3>
                <p class="text-xs text-dark-muted-foreground" data-ps="src/components/home/ContactForm.astro:p5uxv7">9.0 SeismicCo Engineering Facilities</p>
                <p class="text-xs text-dark-muted-foreground" data-ps="src/components/home/ContactForm.astro:p5uxv6">Fast Nationwide Job-Site Dispatch</p>
              </div>
            </div>

            <div class="flex items-start gap-4" data-ps="src/components/home/ContactForm.astro:fufm9g">
              <div class="w-10 h-10 bg-primary/20 border border-primary/30 flex items-center justify-center text-primary shrink-0 rounded-sm" data-ps="src/components/home/ContactForm.astro:fufm9f">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div data-ps="src/components/home/ContactForm.astro:fufm9e">
                <h3 class="text-sm font-bold text-dark-foreground mb-1" data-ps="src/components/home/ContactForm.astro:dbgyq">Submittal Turnaround</h3>
                <p class="text-xs text-dark-muted-foreground" data-ps="src/components/home/ContactForm.astro:p5uxv5">Standard submittal packages returned within 24–48 business hours.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 p-4 bg-secondary/50 border border-dark-border rounded-sm" data-ps="src/components/home/ContactForm.astro:fufm9d">
          <p class="text-xs font-mono text-dark-muted-foreground" data-ps="src/components/home/ContactForm.astro:p5uxuj">
            <strong class="text-dark-foreground font-bold">Contractor Note:</strong> If you have architectural drawings or PE specifications ready, note your project location and seismic design category (SDC) below.
          </p>
        </div>
      </div>

      <!-- Right Column: RFQ Form -->
      <div class="lg:col-span-7" data-ps="src/components/home/ContactForm.astro:9ocn1j">
        <div class="bg-secondary/40 border border-dark-border p-6 md:p-8 rounded-sm" data-ps="src/components/home/ContactForm.astro:9ocn1i">
          <div id="contact-status" class="hidden mb-6 px-4 py-3 rounded-sm text-sm" data-ps="src/components/home/ContactForm.astro:9ocn1h"></div>

          <form id="contact-form" class="space-y-4">
            <input type="hidden" name="_formId" value="contact" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactForm.astro:9ocn1g">
              <div data-ps="src/components/home/ContactForm.astro:9ocn1f">
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-dark-muted-foreground mb-1" data-ps="src/components/home/ContactForm.astro:5gyyrs">Full Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. David Miller"
                  class="w-full px-3.5 py-2.5 bg-dark-background border border-dark-border text-dark-foreground placeholder-dark-muted-foreground text-sm rounded-sm focus:outline-none focus:border-primary transition-colors"
                />
              </div>
              <div data-ps="src/components/home/ContactForm.astro:9ocn1e">
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-dark-muted-foreground mb-1" data-ps="src/components/home/ContactForm.astro:5gyyr6">Work Email *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="e.g. dmiller@contractor.com"
                  class="w-full px-3.5 py-2.5 bg-dark-background border border-dark-border text-dark-foreground placeholder-dark-muted-foreground text-sm rounded-sm focus:outline-none focus:border-primary transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactForm.astro:9ocn1d">
              <div data-ps="src/components/home/ContactForm.astro:9ocn1c">
                <label for="company" class="block text-xs font-bold uppercase tracking-wider text-dark-muted-foreground mb-1" data-ps="src/components/home/ContactForm.astro:5gyyr5">Company / Firm *</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  placeholder="e.g. Apex Mechanical Builders"
                  class="w-full px-3.5 py-2.5 bg-dark-background border border-dark-border text-dark-foreground placeholder-dark-muted-foreground text-sm rounded-sm focus:outline-none focus:border-primary transition-colors"
                />
              </div>
              <div data-ps="src/components/home/ContactForm.astro:9ocn1b">
                <label for="projectType" class="block text-xs font-bold uppercase tracking-wider text-dark-muted-foreground mb-1" data-ps="src/components/home/ContactForm.astro:5gyyr4">Facility / Project Type *</label>
                <select
                  id="projectType"
                  name="projectType"
                  required
                  class="w-full px-3.5 py-2.5 bg-dark-background border border-dark-border text-dark-foreground text-sm rounded-sm focus:outline-none focus:border-primary transition-colors"
                >
                  <option value="Hospital / Healthcare">Hospital / Acute Care</option>
                  <option value="Laboratory / Cleanroom">Laboratory / Cleanroom</option>
                  <option value="Commercial MEP / HVAC">Commercial MEP / HVAC</option>
                  <option value="Critical Infrastructure">Data Center / Infrastructure</option>
                  <option value="Custom Bracket Fabrication">Custom Bracket Fabrication</option>
                  <option value="Other">Other Application</option>
                </select>
              </div>
            </div>

            <div data-ps="src/components/home/ContactForm.astro:9ocn1a">
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-dark-muted-foreground mb-1" data-ps="src/components/home/ContactForm.astro:5gyyr3">Project Scope & Kit Requirements *</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Describe the equipment to be anchored, estimated kit quantities, project location, or specific ICC compliance requirements..."
                class="w-full px-3.5 py-2.5 bg-dark-background border border-dark-border text-dark-foreground placeholder-dark-muted-foreground text-sm rounded-sm focus:outline-none focus:border-primary transition-colors"
              ></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit"
              class="w-full py-3.5 px-6 text-sm font-bold uppercase tracking-wider bg-primary text-primary-foreground hover:bg-primary-hover transition-colors rounded-sm shadow-sm cursor-pointer"
            >
              Submit Specification Request
            </button>
          </form>
        </div>
      </div>
    </div>
  </Container>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('contact-status') as HTMLDivElement;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting Request...';

      const formData = new FormData(form);

      try {
        const response = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _formId: formData.get('_formId'),
            name: formData.get('name'),
            email: formData.get('email'),
            company: formData.get('company'),
            projectType: formData.get('projectType'),
            message: formData.get('message'),
          }),
        });

        const result = await response.json();

        if (result.success) {
          status.className = 'mb-6 px-4 py-3 rounded-sm bg-green-950/80 border border-green-700 text-green-200 text-sm';
          status.textContent = 'Thank you! Your specification request has been received. Our engineering department will follow up promptly.';
          form.reset();
        } else {
          throw new Error(result.error || 'Failed to submit request');
        }
      } catch (err) {
        status.className = 'mb-6 px-4 py-3 rounded-sm bg-red-950/80 border border-red-700 text-red-200 text-sm';
        status.textContent = err instanceof Error ? err.message : 'Submission failed. Please try again or email us directly.';
      } finally {
        status.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Specification Request';
      }
    });
  </script>
</section>
