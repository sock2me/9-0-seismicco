---
// Applications Component - 4-Column Structured Technical Grid
import Container from '@/components/Container.astro';
---

<section id="applications" class="py-16 md:py-24 bg-surface border-b border-border" data-ps="src/components/home/Applications.astro:eks8i6">
  <Container>
    <div class="max-w-3xl mb-12 md:mb-16" data-ps="src/components/home/Applications.astro:m2r03v">
      <h2 class="text-h2 font-bold tracking-tight text-foreground mb-4" data-ps="src/components/home/Applications.astro:rvhjhd">
        Trusted Across Critical Facilities
      </h2>
      <p class="text-base md:text-lg text-muted-foreground leading-relaxed" data-ps="src/components/home/Applications.astro:bydwtl">
        9.0 SeismicCo provides engineered anchoring solutions for high-consequence environments where vibration mitigation and structural compliance are non-negotiable.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-ps="src/components/home/Applications.astro:m2r03w">
      <!-- Card 1: Hospitals -->
      <div class="bg-background border border-border p-6 rounded-sm flex flex-col justify-between hover:border-primary transition-colors" data-ps="src/components/home/Applications.astro:m2r03x">
        <div data-ps="src/components/home/Applications.astro:m2r03y">
          <div class="w-10 h-10 bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-5 rounded-sm" data-ps="src/components/home/Applications.astro:m2r03z">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-3" data-ps="src/components/home/Applications.astro:d72m94">
            Acute Care Hospitals
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Applications.astro:bydwtm">
            Meets stringent hospital accreditation criteria for patient monitors, surgical equipment, diagnostic machinery, and overhead utility lines.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between text-xs font-semibold text-foreground" data-ps="src/components/home/Applications.astro:m2r040">
          <span data-ps="src/components/home/Applications.astro:c3w97e">Healthcare Compliance</span>
          <span class="text-primary font-bold" data-ps="src/components/home/Applications.astro:c3w97d">Grade A</span>
        </div>
      </div>

      <!-- Card 2: Cleanrooms & Labs -->
      <div class="bg-background border border-border p-6 rounded-sm flex flex-col justify-between hover:border-primary transition-colors" data-ps="src/components/home/Applications.astro:m2r041">
        <div data-ps="src/components/home/Applications.astro:m2r042">
          <div class="w-10 h-10 bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary mb-5 rounded-sm" data-ps="src/components/home/Applications.astro:wsgmye">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-3" data-ps="src/components/home/Applications.astro:d72m95">
            Laboratories & Cleanrooms
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Applications.astro:bydwtn">
            Non-invasive and structural seismic tethering for mass spectrometers, fume hoods, biosafety cabinets, and sensitive optical benches.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between text-xs font-semibold text-foreground" data-ps="src/components/home/Applications.astro:wsgmyf">
          <span data-ps="src/components/home/Applications.astro:c3w97c">Containment Rigidity</span>
          <span class="text-primary font-bold" data-ps="src/components/home/Applications.astro:c3w97b">Zero-Shift</span>
        </div>
      </div>

      <!-- Card 3: Commercial MEP -->
      <div class="bg-background border border-border p-6 rounded-sm flex flex-col justify-between hover:border-primary transition-colors" data-ps="src/components/home/Applications.astro:wsgmyg">
        <div data-ps="src/components/home/Applications.astro:wsgmyh">
          <div class="w-10 h-10 bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-5 rounded-sm" data-ps="src/components/home/Applications.astro:wsgmyi">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-3" data-ps="src/components/home/Applications.astro:d72m96">
            Heavy Mechanical & MEP
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Applications.astro:bydwto">
            Engineered bracing and strut brackets for chillers, boilers, HVAC ductwork, cable trays, and pressurized industrial piping loops.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between text-xs font-semibold text-foreground" data-ps="src/components/home/Applications.astro:wsgmyj">
          <span data-ps="src/components/home/Applications.astro:c3w97a">Ductile Restraint</span>
          <span class="text-primary font-bold" data-ps="src/components/home/Applications.astro:c3w979">IBC 1613</span>
        </div>
      </div>

      <!-- Card 4: Architectural Non-Structural -->
      <div class="bg-background border border-border p-6 rounded-sm flex flex-col justify-between hover:border-primary transition-colors" data-ps="src/components/home/Applications.astro:wsgmyk">
        <div data-ps="src/components/home/Applications.astro:wsgmyl">
          <div class="w-10 h-10 bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary mb-5 rounded-sm" data-ps="src/components/home/Applications.astro:wsgmym">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
            </svg>
          </div>
          <h3 class="text-h3 font-bold text-foreground mb-3" data-ps="src/components/home/Applications.astro:d72m97">
            Architectural & Facilities
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Applications.astro:bydwtp">
            Comprehensive anchoring systems for high-bay storage racks, server rooms, architectural partitions, and emergency power systems.
          </p>
        </div>
        <div class="pt-4 border-t border-border flex items-center justify-between text-xs font-semibold text-foreground" data-ps="src/components/home/Applications.astro:wsgmyn">
          <span data-ps="src/components/home/Applications.astro:c3w978">Structural Anchoring</span>
          <span class="text-primary font-bold" data-ps="src/components/home/Applications.astro:c3w96m">ASCE 7</span>
        </div>
      </div>
    </div>
  </Container>
</section>
