---
// Products & Kits Component - Dark High-Density Catalog Matrix
import Container from '@/components/Container.astro';
---

<section id="products" class="py-16 md:py-24 bg-dark-background border-b border-dark-border text-dark-foreground" data-ps="src/components/home/Products.astro:xpj37q">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-16 gap-6" data-ps="src/components/home/Products.astro:elr73h">
      <div class="max-w-2xl" data-ps="src/components/home/Products.astro:elr73g">
        <h2 class="text-h2 font-bold tracking-tight text-dark-foreground mb-4" data-ps="src/components/home/Products.astro:y1mlgm">
          Pre-Manufactured Brackets & Rapid Kits
        </h2>
        <p class="text-base md:text-lg text-dark-muted-foreground leading-relaxed" data-ps="src/components/home/Products.astro:jw83dc">
          Making it easy to get the right parts for the right need — in the shortest amount of time possible. Complete hardware sets ready for rapid job-site installation.
        </p>
      </div>
      <div data-ps="src/components/home/Products.astro:elr72u">
        <a href="#contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold bg-primary text-primary-foreground hover:bg-primary-hover transition-colors rounded-sm no-underline shadow-sm" data-ps="src/components/home/Products.astro:csa6q1">
          Download Kit Catalog
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-ps="src/components/home/Products.astro:elr72t">
      <!-- Product Card 1 -->
      <div class="bg-secondary/40 border border-dark-border rounded-sm overflow-hidden flex flex-col justify-between" data-ps="src/components/home/Products.astro:elr72s">
        <div data-ps="src/components/home/Products.astro:elr72r">
          <div class="relative aspect-[16/10] overflow-hidden bg-black/40 border-b border-dark-border" data-ps="src/components/home/Products.astro:elr72q">
            <img
              src="https://images.pexels.com/photos/38730229/pexels-photo-38730229.jpeg?auto=compress&cs=tinysrgb&w=1200"
              alt="Commercial mechanical piping seismic restraint brackets"
              class="w-full h-full object-cover"
              loading="lazy"
              width="600"
              height="375" data-ps="src/components/home/Products.astro:h40bf1" />
          </div>
          <div class="p-6" data-ps="src/components/home/Products.astro:elr72p">
            <div class="flex items-center justify-between mb-2" data-ps="src/components/home/Products.astro:elr72o">
              <span class="text-xs font-mono font-bold text-primary uppercase tracking-wider" data-ps="src/components/home/Products.astro:uxutq0">Catalog #BKT-9100</span>
              <span class="text-xs font-semibold text-dark-muted-foreground" data-ps="src/components/home/Products.astro:uxutpz">Heavy Steel</span>
            </div>
            <h3 class="text-h3 font-bold text-dark-foreground mb-3" data-ps="src/components/home/Products.astro:jd7o8z">
              Pre-Manufactured Brackets
            </h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Products.astro:jw83db">
              Precision laser-cut structural steel angle brackets, gusset plates, and heavy-gauge seismic saddles built to withstand lateral and vertical shock load requirements.
            </p>
            <ul class="list-none p-0 m-0 space-y-2 text-xs text-dark-muted-foreground">
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhv5">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutpy"></span>
                <span data-ps="src/components/home/Products.astro:uxutpx">Heavy-gauge carbon steel & 316 stainless options</span>
              </li>
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvr">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutpw"></span>
                <span data-ps="src/components/home/Products.astro:uxutpv">Pre-drilled anchor bolt patterns for rapid fit</span>
              </li>
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvs">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutpu"></span>
                <span data-ps="src/components/home/Products.astro:uxutpt">ICC-ES certified design calculations</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="p-6 pt-0 mt-4" data-ps="src/components/home/Products.astro:elr72n">
          <a href="#contact" class="block text-center py-2.5 px-4 text-xs font-bold uppercase tracking-wider bg-dark-border hover:bg-primary hover:text-primary-foreground text-dark-foreground transition-colors rounded-sm no-underline border border-dark-border" data-ps="src/components/home/Products.astro:csa6q0">
            Request Bracket Specs
          </a>
        </div>
      </div>

      <!-- Product Card 2 -->
      <div class="bg-secondary/40 border border-dark-border rounded-sm overflow-hidden flex flex-col justify-between" data-ps="src/components/home/Products.astro:elr72m">
        <div data-ps="src/components/home/Products.astro:elr72l">
          <div class="relative aspect-[16/10] overflow-hidden bg-black/40 border-b border-dark-border" data-ps="src/components/home/Products.astro:azh71x">
            <img
              src="https://images.pexels.com/photos/31921202/pexels-photo-31921202.jpeg?auto=compress&cs=tinysrgb&w=1200"
              alt="Pre-packaged seismic anchoring rapid kit assembly"
              class="w-full h-full object-cover"
              loading="lazy"
              width="600"
              height="375" data-ps="src/components/home/Products.astro:h40bf0" />
          </div>
          <div class="p-6" data-ps="src/components/home/Products.astro:azh71y">
            <div class="flex items-center justify-between mb-2" data-ps="src/components/home/Products.astro:azh71z">
              <span class="text-xs font-mono font-bold text-primary uppercase tracking-wider" data-ps="src/components/home/Products.astro:uxutp7">Kit #RK-SERIES</span>
              <span class="text-xs font-semibold text-dark-muted-foreground" data-ps="src/components/home/Products.astro:uxutp6">Complete Bundle</span>
            </div>
            <h3 class="text-h3 font-bold text-dark-foreground mb-3" data-ps="src/components/home/Products.astro:jd7o90">
              Pre-Packaged Rapid Kits
            </h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Products.astro:jw83da">
              Contractor-ready job kits packaged with all required brackets, wedge anchors, graded hardware, and manufacturer torque specifications for immediate deployment.
            </p>
            <ul class="list-none p-0 m-0 space-y-2 text-xs text-dark-muted-foreground">
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvt">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutp5"></span>
                <span data-ps="src/components/home/Products.astro:uxutp4">All bolts, washers, and anchoring hardware included</span>
              </li>
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvu">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutp3"></span>
                <span data-ps="src/components/home/Products.astro:uxutp2">Color-coded job bags to reduce field labor time</span>
              </li>
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvv">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutp1"></span>
                <span data-ps="src/components/home/Products.astro:uxutp0">Immediate dispatch from central manufacturing</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="p-6 pt-0 mt-4" data-ps="src/components/home/Products.astro:azh720">
          <a href="#contact" class="block text-center py-2.5 px-4 text-xs font-bold uppercase tracking-wider bg-dark-border hover:bg-primary hover:text-primary-foreground text-dark-foreground transition-colors rounded-sm no-underline border border-dark-border" data-ps="src/components/home/Products.astro:csa6pe">
            Request Kit Pricing
          </a>
        </div>
      </div>

      <!-- Product Card 3 -->
      <div class="bg-secondary/40 border border-dark-border rounded-sm overflow-hidden flex flex-col justify-between" data-ps="src/components/home/Products.astro:azh721">
        <div data-ps="src/components/home/Products.astro:azh722">
          <div class="relative aspect-[16/10] overflow-hidden bg-black/40 border-b border-dark-border" data-ps="src/components/home/Products.astro:azh723">
            <img
              src="https://images.pexels.com/photos/36449518/pexels-photo-36449518.jpeg?auto=compress&cs=tinysrgb&w=1200"
              alt="Custom structural steel seismic anchoring hardware"
              class="w-full h-full object-cover"
              loading="lazy"
              width="600"
              height="375" data-ps="src/components/home/Products.astro:h40bez" />
          </div>
          <div class="p-6" data-ps="src/components/home/Products.astro:azh724">
            <div class="flex items-center justify-between mb-2" data-ps="src/components/home/Products.astro:azh725">
              <span class="text-xs font-mono font-bold text-primary uppercase tracking-wider" data-ps="src/components/home/Products.astro:uxutoz">Custom #ENG-SPEC</span>
              <span class="text-xs font-semibold text-dark-muted-foreground" data-ps="src/components/home/Products.astro:uxutoy">Engineered</span>
            </div>
            <h3 class="text-h3 font-bold text-dark-foreground mb-3" data-ps="src/components/home/Products.astro:jd7o91">
              Custom Structural Anchors
            </h3>
            <p class="text-sm text-dark-muted-foreground leading-relaxed mb-6" data-ps="src/components/home/Products.astro:jw83d9">
              Tailored seismic hardware engineered to specific project drawings, extreme load scenarios, structural concrete constraints, and unique mechanical layouts.
            </p>
            <ul class="list-none p-0 m-0 space-y-2 text-xs text-dark-muted-foreground">
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvw">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutoc"></span>
                <span data-ps="src/components/home/Products.astro:uxutob">Collaborative PE-stamped drawing analysis</span>
              </li>
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvx">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxutoa"></span>
                <span data-ps="src/components/home/Products.astro:uxuto9">Rapid CAD/CAM prototype and fabrication</span>
              </li>
              <li class="flex items-center gap-2" data-ps="src/components/home/Products.astro:yslhvy">
                <span class="w-1.5 h-1.5 bg-primary rounded-full" data-ps="src/components/home/Products.astro:uxuto8"></span>
                <span data-ps="src/components/home/Products.astro:uxuto7">Custom load capacity load cell verification</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="p-6 pt-0 mt-4" data-ps="src/components/home/Products.astro:azh726">
          <a href="#contact" class="block text-center py-2.5 px-4 text-xs font-bold uppercase tracking-wider bg-dark-border hover:bg-primary hover:text-primary-foreground text-dark-foreground transition-colors rounded-sm no-underline border border-dark-border" data-ps="src/components/home/Products.astro:csa6pd">
            Submit Drawing for Quote
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>
